# cmx-flow-server 配置示例（可选）。
#
# 加载顺序：本文件（路径由 CONFIG_FILE 指定，回退 FLOW_CONFIG，或默认 ./flow-server.toml）→ 环境变量覆盖。
# 环境变量优先级最高。框架级 + 认证/数据源均可写 toml（认证/数据源段由 main.rs apply_toml_env
# 注入 FLOW_* 环境变量；env 已显式设置则覆盖 toml）。

# —— chassis 框架级（FLOW_ 前缀环境变量可覆盖：FLOW_HOST/FLOW_PORT/FLOW_LOG_DIR/…）——
host = "0.0.0.0"
port = 8091
log_dir = "logs"
log_level = "info"                 # RUST_LOG 未设时用
graceful_timeout_secs = 10

# —— 数据源（toml 段；→ FLOW_PG_URL / IAM_PG_URL）——
[datasource]
# flow_pg_url = "postgres://postgres:postgres@127.0.0.1:5432/fico"   # 运行态 + 定义库
# iam_pg_url  = "postgres://postgres:postgres@127.0.0.1:5432/cmx"    # 候选人/组织库（pg 模式）

# —— 认证（toml 段；→ FLOW_AUTH_MODE/FLOW_JWT_*/FLOW_API_KEYS/FLOW_TENANCY）——
# 平台经 FlowProxyModule 转发时注入 X-API-Key + X-Delegated-User-Token（委托令牌始终验签）。
[auth]
# mode = "off" | "jwt"            # off(默认)=X-Tenant 头/默认租户；jwt=验签取 claim。生产务必 jwt
# jwt_alg = "HS256"               # 默认 HS256（或 RS256）
# jwt_secret = "…"                # HS256 密钥——★须 = 平台签发 JWT 密钥（否则委托令牌验签 401）
# jwt_public_key = "-----BEGIN PUBLIC KEY-----…"  # RS256 PEM 公钥（RS256 时）
# jwt_tenant_claim = "tenant"     # 租户 claim 名（默认 tenant）
# jwt_roles_claim = "roles"       # 角色 claim 名（默认 roles）
# api_keys = "svckey:tenantA,k2:tenantB"   # 服务间 key:租户，逗号分隔；无冒号=默认租户。
#                                  ★命中即免 JWT；须 = 平台 [service_auth].outgoing_api_key
# tenancy = "single" | "multi"    # 多租户 db-per-tenant 隔离（默认 single 单库）

# —— 平台对接对齐清单（S6，最关键）——
# 门户走独立微服务模式（平台 dev-local.toml 配了 [center_client.urls].flow）时，两个值必须对齐，
# 否则平台代理请求被 flow-server 判 401 → 门户跳登录：
#   1. [auth].api_keys 的 key   = 平台 [service_auth].outgoing_api_key
#   2. [auth].jwt_secret        = 平台签发 JWT 的密钥（cmx-auth JwtConfig 默认或 dev-local 自定义）
# 真实配置见同目录 flow-server.toml。

# —— flow 专属（仍用环境变量；toml 未覆盖这些）——
# 适配器选择（S1，默认全 pg=回连库；独立部署常用 http/mock）：
# FLOW_IDENTITY_MODE = "mock" | "http" | "pg"   （+ FLOW_IDENTITY_URL）
# FLOW_SUBFLOW_MODE  = "mock" | "http" | "pg"   （+ FLOW_SUBFLOW_URL）
# FLOW_DELEGATE_MODE = "mock" | "http" | "pg"   （+ FLOW_DELEGATE_URL）
# 出站生命周期 webhook（S1）：FLOW_WEBHOOK_URLS / FLOW_WEBHOOK_SIGNING_KEY / FLOW_WEBHOOK_MAX_RETRIES
# 多租户库 URL（multi 时）：FLOW_TENANT_DB_URL_TEMPLATE / FLOW_TENANT_<T>_PG_URL 等
#
# —— headless 对外契约（S3）——
# 端点：/api/flow/v1/*（正式契约）+ /api/flow/*（旧,兼容并存）。
# 文档：/api/flow/v1/openapi.json + /api/flow/v1/docs（swagger UI，免认证）。
# 实时：/api/flow/v1/events（SSE 生命周期事件流，按租户过滤）。



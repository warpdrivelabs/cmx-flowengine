<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:flowable="http://flowable.org/bpmn"
                  xmlns:cmx="http://cmx.io/bpmn"
                  targetNamespace="http://cmx.io/flow/biztest"
                  id="defs_fin_review_branch">
  <bpmn:process id="fin_review_branch" name="分公司财务单签" isExecutable="true">

    <bpmn:startEvent id="s" name="开始">
      <bpmn:outgoing>a</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="finb" name="分公司财务经理单签" flowable:assignee="u_finb">
      <bpmn:incoming>a</bpmn:incoming>
      <bpmn:outgoing>b</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="e" name="复核通过">
      <bpmn:incoming>b</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="a" sourceRef="s" targetRef="finb"/>
    <bpmn:sequenceFlow id="b" sourceRef="finb" targetRef="e"/>

  </bpmn:process>
</bpmn:definitions>

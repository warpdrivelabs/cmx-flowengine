<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:flowable="http://flowable.org/bpmn"
                  xmlns:cmx="http://cmx.io/bpmn"
                  targetNamespace="http://cmx.io/flow/biztest"
                  id="defs_fin_review_hq">
  <bpmn:process id="fin_review_hq" name="总部财务三级复核" isExecutable="true">

    <bpmn:startEvent id="s" name="开始">
      <bpmn:outgoing>a</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="fin1" name="财务初审" flowable:assignee="u_fin1">
      <bpmn:incoming>a</bpmn:incoming>
      <bpmn:outgoing>b</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="fin2" name="财务经理复核" flowable:assignee="u_fin2">
      <bpmn:incoming>b</bpmn:incoming>
      <bpmn:outgoing>c</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="fin3" name="财务总监审批" flowable:assignee="u_fin3">
      <bpmn:incoming>c</bpmn:incoming>
      <bpmn:outgoing>d</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="e" name="复核通过">
      <bpmn:incoming>d</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="a" sourceRef="s" targetRef="fin1"/>
    <bpmn:sequenceFlow id="b" sourceRef="fin1" targetRef="fin2"/>
    <bpmn:sequenceFlow id="c" sourceRef="fin2" targetRef="fin3"/>
    <bpmn:sequenceFlow id="d" sourceRef="fin3" targetRef="e"/>

  </bpmn:process>
</bpmn:definitions>

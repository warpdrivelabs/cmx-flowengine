<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:cmx="http://cmx.io/bpmn" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="http://cmx.io/flow/test" id="d_par_gw">
  <bpmn:process id="par_gw" name="并行网关双分支" isExecutable="true">
    <bpmn:startEvent id="s"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="fork" name="并行分叉"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>fa</bpmn:outgoing><bpmn:outgoing>fb</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="legal" name="法务审查" flowable:assignee="u_auditor1"><bpmn:incoming>fa</bpmn:incoming><bpmn:outgoing>ja</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="fin" name="财务审查" flowable:assignee="u_cfo"><bpmn:incoming>fb</bpmn:incoming><bpmn:outgoing>jb</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="join" name="并行汇合"><bpmn:incoming>ja</bpmn:incoming><bpmn:incoming>jb</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:endEvent id="e"><bpmn:incoming>f2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="fork"/>
    <bpmn:sequenceFlow id="fa" sourceRef="fork" targetRef="legal"/>
    <bpmn:sequenceFlow id="fb" sourceRef="fork" targetRef="fin"/>
    <bpmn:sequenceFlow id="ja" sourceRef="legal" targetRef="join"/>
    <bpmn:sequenceFlow id="jb" sourceRef="fin" targetRef="join"/>
    <bpmn:sequenceFlow id="f2" sourceRef="join" targetRef="e"/>
  </bpmn:process>
</bpmn:definitions>
